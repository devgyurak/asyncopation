__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/
.coverage
htmlcov/
.env

# Benchmark results are never committed (only bench/baseline is)
bench/results/*
!bench/results/.gitkeep

# Agent configuration is part of the repo; re-include it even if a global gitignore
# excludes .claude/. Only personal settings stay ignored.
!.claude/
.claude/settings.local.json
.pi/sessions/
